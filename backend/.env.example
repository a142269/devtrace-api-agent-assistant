# Copy this file to .env and add your own model provider key.
# Never commit .env.

# Anthropic-compatible model provider (DeepSeek is one supported option)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-chat
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Redis
REDIS_PASSWORD=change-me-for-local-development
REDIS_URL=redis://:change-me-for-local-development@redis:6379/0

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# Monitoring
PROMETHEUS_PORT=9090
MONITOR_INTERVAL=60
ALERT_WEBHOOK_URL=

# Run python setup_local.py to generate DEVTRACE_JWT_SECRET and DEVTRACE_USERS_JSON
# in the ignored .env file. Do not put credentials in this example.
DEVTRACE_CORS_ORIGINS=http://localhost:5173

# Interrupted-task detection. Keep this above the 150s per-run timeout and the
# 180s session lock, otherwise a healthy long run could be marked interrupted.
# DEVTRACE_TASK_STALE_SECONDS=240

# Durable streaming tasks: enable only when the queue worker (python -m api.worker)
# is running. Docker Compose enables it for the devtrace and worker services.
# DEVTRACE_TASK_QUEUE=disabled

# Route public API documentation tools through the bundled MCP server.
# DEVTRACE_MCP_PUBLIC_TOOLS=disabled

# Route every read-only diagnosis tool (request trace, key scope, webhook
# delivery, quota/docs lookups) through the bundled MCP server. Creating a
# support ticket always stays a local, user-authorized tool.
# DEVTRACE_MCP_ALL_TOOLS=disabled

# Score safe plan orderings (records-first vs docs-first) before execution.
# DEVTRACE_PLANNING_CANDIDATES=disabled

# Comma-separated usernames allowed to read the admin-only audit stream
# (GET /developer/audit). The role is resolved server-side against this list
# and never stored in the JWT. Names that are not configured users are ignored.
# Leave unset so the endpoint stays 403 for everybody.
# DEVTRACE_ADMIN_USERS=

# Workspace-aware user configuration (optional). Both formats are accepted:
#   legacy:  {"alice": "pbkdf2_sha256$<salt>$<digest>"}              -> workspace "default"
#   new:     {"alice": {"password": "pbkdf2_sha256$<salt>$<digest>", "workspace": "acme"}}
# Workspace names must match ^[A-Za-z0-9_-]{1,40}$; an invalid configuration
# fails at startup. The workspace is resolved server-side only and never
# written into the JWT. Placeholder hashes below - never commit real values.
# DEVTRACE_USERS_JSON='{"alice": {"password": "pbkdf2_sha256$00...00$00...00", "workspace": "acme"}}'

# Durable task queue tuning (P3). Leases let a surviving worker reclaim a task
# whose owner crashed mid-run. DEVTRACE_TASK_LEASE_SECONDS is the per-task lease
# in seconds (default 90, minimum 30); a running task whose lease lapses is
# requeued through the delayed path by another worker. Retries back off
# exponentially (1s, 2s, 4s, capped at 30s) via the Redis delayed sorted set.
# DEVTRACE_TASK_LEASE_SECONDS=90
